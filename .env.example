# Copy values into your shell or process manager. The server does not auto-load .env.
POKERDRAFT_BIND=127.0.0.1:3000
POKERDRAFT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POKERDRAFT_DB=data/pokerdraft.db
POKERDRAFT_WEB=web/dist
POKERDRAFT_SEATS=6
POKERDRAFT_AUCTION_MS=1000
POKERDRAFT_PRICING=second_price
POKERDRAFT_DEMO=true
# Generate and set your own random secret (32+ characters); never commit it.
